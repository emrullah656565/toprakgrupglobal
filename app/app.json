{
  "expo": {
    "name": "Toprak Lastik",
    "description": "Canlı stok, akıllı lastik arama, fiyat alarmı ve güvenli alışveriş deneyimi.",
    "slug": "toprak-one",
    "owner": "toprakgrup",
    "version": "1.2.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Toprak Lastik, lastik ebatını kamerayla okuyabilmek için kameraya erişmek istiyor.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "android": {
      "package": "com.toprakgrupglobal.toprakone",
      "versionCode": 8,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080808"
      }
    },
    "ios": {
      "bundleIdentifier": "com.toprakgrupglobal.toprakone",
      "supportsTablet": true,
      "buildNumber": "8"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "extra": {
      "eas": {
        "projectId": "0fb1935c-0ddc-4e43-ad9a-8d4e688e2849"
      }
    }
  }
}
